# Скопируйте файл в .env. Сам .env в .gitignore — реальные секреты не коммитим.
#
# Локально без .env всё работает: в development и test приложение подставляет
# дев-значения секретов (см. src/config/env.ts). В production так нельзя —
# там переменные JWT_* обязательны, и приложение откажется стартовать, если
# они не заданы или равны дев-значениям ниже.
#
# Сгенерировать боевой секрет:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

DB_PATH=database.sqlite

# Именно эти строки прод считает дев-значениями и отвергает — не переносите их
# на боевой стенд. Ключи должны различаться между собой: одинаковый секрет
# делает refresh-токен пригодным там, где ожидается access.
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-production

# Origin(ы) фронтенда, которым разрешены запросы с cookie.
# Через запятую, если их несколько (например, dev + staging).
CORS_ORIGIN=http://localhost:3000

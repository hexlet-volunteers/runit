{
  "name": "runit",
  "private": true,
  "version": "0.2.3",
  "description": "online editor for coding",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && tsx watch src/server.ts",
    "build": "tsc && node bin/fix-esm-imports.mjs",
    "build:frontend": "cd frontend && npm ci --include=dev && npm run build && rm -rf node_modules",
    "heroku-postbuild": "npm run build && npm run build:frontend",
    "start": "node dist/server.js",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "generate:types": "tsc --emitDeclarationOnly --outDir types",
    "runner:build-images": "tsx src/runner/buildImages.ts",
    "runner:pull-images": "tsx src/runner/pullImages.ts",
    "test:runner": "node --import tsx --test src/runner/*.test.ts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "runner:smoke": "node bin/runner-smoke.mjs",
    "test": "npm run test:runner && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-rus/runit.git"
  },
  "author": "",
  "license": "Affero GPL 3.0",
  "bugs": {
    "url": "https://github.com/hexlet-rus/runit/issues"
  },
  "homepage": "https://github.com/hexlet-rus/runit#readme",
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@trpc/server": "^11.8.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.2",
    "drizzle-kit": "^0.31.5",
    "jest": "^30.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

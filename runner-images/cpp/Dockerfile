# Образ для серверного исполнения C++-сниппетов.
# Особенности:
# - Берём чистый alpine и ставим только g++ (компилятор) и libstdc++
#   (рантайм стандартной библиотеки, нужен уже собранному бинарнику).
#   Полный build-base не нужен: make/autotools здесь не используются.
# - Alpine основан на musl, а не glibc — это нормально для учебных сниппетов,
#   но код, завязанный на glibc-специфику, может вести себя иначе.
# - Rootfs read-only: раннер компилирует и складывает бинарник в /tmp
#   (единственный writable tmpfs), запуск идёт оттуда же.
# - Сети нет (--network=none), сторонние библиотеки недоступны — только STL.
FROM alpine:3.20

RUN apk add --no-cache g++ libstdc++

RUN adduser -D -u 10001 runner

WORKDIR /app
USER 10001
